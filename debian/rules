#!/usr/bin/make -f
# AbraFlexi Zabbix monitoring package rules

%:
	dh $@ --with phpcomposer

override_dh_install:
	dh_install
	# Modify PHP files to use system-wide configuration paths after files are installed
	sed -i "s|'\.\.\/\.env'|'/etc/abraflexi-zabbix/.env'|g" debian/abraflexi-zabbix/usr/lib/abraflexi-zabbix/*.php || true
	sed -i 's|"\.\.\/.env"|"/etc/abraflexi-zabbix/.env"|g' debian/abraflexi-zabbix/usr/lib/abraflexi-zabbix/*.php || true
	sed -i "s|'\.\.\/\.env'|'/etc/abraflexi-zabbix/.env'|g" debian/abraflexi-zabbix/usr/lib/abraflexi-zabbix/AbraFlexi/Zabbix/Feeder.php || true
	sed -i 's|"\.\.\/.env"|"/etc/abraflexi-zabbix/.env"|g' debian/abraflexi-zabbix/usr/lib/abraflexi-zabbix/AbraFlexi/Zabbix/Feeder.php || true
	# Install Debian autoloader
	install -D -m 0644 debian/autoload.php debian/abraflexi-zabbix/usr/share/php/abraflexi-zabbix/autoload.php
	# Replace autoload path for installed package
	sed -i "/__DIR__/c\require_once '/usr/share/php/abraflexi-zabbix/autoload.php';" debian/abraflexi-zabbix/usr/lib/abraflexi-zabbix/*.php || true
