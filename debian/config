#!/bin/bash

set -e

. /usr/share/debconf/confmodule

# Check if this is a reconfiguration
if [ "$1" = "reconfigure" ]; then
    # During reconfiguration, always prompt for configuration
    db_fset abraflexi-zabbix/abraflexi_url seen false || true
    db_fset abraflexi-zabbix/abraflexi_login seen false || true  
    db_fset abraflexi-zabbix/abraflexi_password seen false || true
fi

# Prompt for configuration values
db_input medium abraflexi-zabbix/abraflexi_url || true
db_input medium abraflexi-zabbix/abraflexi_login || true
db_input medium abraflexi-zabbix/abraflexi_password || true

db_go || true