{
  "name": "deb/abraflexi-zabbix",
  "description": "Monitor Your AbraFlexi using Zabbix",
  "type": "project",
  "authors": [
    {
      "name": "Vítězslav Dvořák",
      "email": "info@vitexsoftware.cz"
    }
  ],
  "config": {
    "vendor-dir": "/var/lib/composer/abraflexi-zabbix"
  },
  "require": {
    "deb/abraflexi": "*",
    "deb/ease-core": "*"
  },
  "autoload": {
    "psr-4": {
      "AbraFlexi\\Zabbix\\": "./"
    }
  },
  "repositories": [
    {
      "type": "path",
      "url": "/usr/share/php/EaseCore"
    },
    {
      "type": "path",
      "url": "/usr/share/php/AbraFlexi"
    }
  ]
}
