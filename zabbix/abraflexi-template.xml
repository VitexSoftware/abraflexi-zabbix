                <item>
                    <uuid>748ad4d098d447d492bb935c178a7b20</uuid>
                    <name>Latest testing version numeric</name>
                    <type>DEPENDENT</type>
                    <key>abraflexi.update.latestTesting.numeric</key>
                    <delay>0</delay>
                    <history>30d</history>
                    <trends>365d</trends>
                    <value_type>UNSIGNED</value_type>
                    <master_item>
                    <key>abraflexi.update.latestTesting</key>
                    </master_item>
                    <preprocessing>
                        <step>
                            <type>JAVASCRIPT</type>
                            <parameters>
                                <parameter>var parts = value.split('.');
var major = parseInt(parts[0], 10) || 0;
var minor = parseInt(parts[1] || '0', 10);
var patch = parseInt(parts[2] || '0', 10);
return major * 1000000 + minor * 1000 + patch;</parameter>
                            </parameters>
                        </step>
                    </preprocessing>

                    <tags>
                        <tag>
                            <tag>Application</tag>
                            <value>AbraFlexi</value>
                        </tag>
