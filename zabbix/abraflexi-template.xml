            <discovery_rules>
                <discovery_rule>
                    <uuid>748ad4d098d447d492bb935c178a7a90</uuid>
                    <name>AbraFlexi Companies Discovery</name>
                    <type>ZABBIX_AGENT</type>
                    <key>abraflexi.company.lld</key>
                    <delay>1h</delay>
                    <description>Discovers all available AbraFlexi companies/databases</description>
                    <item_prototypes>
                        <item_prototype>
                            <uuid>748ad4d098d447d492bb935c178a7a91</uuid>
                            <name>Company {#COMPANY_NAME} availability</name>
                            <type>CALCULATED</type>
                            <key>abraflexi.company.available[{#COMPANY_CODE}]</key>
                            <history>30d</history>
                            <trends>365d</trends>
                            <value_type>UNSIGNED</value_type>
                            <params>last(//abraflexi.network.overall)</params>
                            <description>Availability status for company {#COMPANY_NAME} (DB: {#COMPANY_DB})</description>
                            <valuemap>
                                <name>Service state</name>
                            </valuemap>
                            <tags>
                                <tag>
                                    <tag>component</tag>
                                    <value>company</value>
                                </tag>
                                <tag>
                                    <tag>company</tag>
                                    <value>{#COMPANY_CODE}</value>
                                </tag>
                            </tags>
                        </item_prototype>
                    </item_prototypes>
                    <trigger_prototypes>
                        <trigger_prototype>
                            <uuid>748ad4d098d447d492bb935c178a7a95</uuid>
                            <expression>last(/AbraFlexi Server Monitoring/abraflexi.company.available[{#COMPANY_CODE}])=0</expression>
                            <name>AbraFlexi company {#COMPANY_NAME} is unavailable</name>
                            <priority>HIGH</priority>
                            <description>Company {#COMPANY_NAME} (database: {#COMPANY_DB}) is not accessible. This could indicate network issues, service downtime, authentication problems, or company deletion.</description>
                            <tags>
                                <tag>
                                    <tag>scope</tag>
                                    <value>availability</value>
                                </tag>
                                <tag>
                                    <tag>company</tag>
                                    <value>{#COMPANY_CODE}</value>
                                </tag>
                            </tags>
                        </trigger_prototype>
                    </trigger_prototypes>
                </discovery_rule>
            </discovery_rules>

            <triggers>
                <!-- Network Issues - Immediate alerting -->
                <trigger>
                    <uuid>748ad4d098d447d492bb935c178a7aa0</uuid>
                    <expression>last(/AbraFlexi Server Monitoring/abraflexi.network.connectivity)=0</expression>
                    <name>AbraFlexi server network connectivity failure</name>
                    <priority>DISASTER</priority>
                    <description>Cannot establish TCP connection to AbraFlexi server. Check network connectivity, server availability, and firewall rules.</description>
                    <tags>
                        <tag>
                            <tag>scope</tag>
                            <value>network</value>
                        </tag>
                    </tags>
                </trigger>

                <!-- Authentication Issues -->
                <trigger>
                    <uuid>748ad4d098d447d492bb935c178a7aa1</uuid>
                    <expression>last(/AbraFlexi Server Monitoring/abraflexi.network.authentication)=0 and last(/AbraFlexi Server Monitoring/abraflexi.network.connectivity)=1</expression>
                    <name>AbraFlexi authentication failure</name>
                    <priority>HIGH</priority>
                    <description>Network connectivity is OK but authentication failed. Check credentials, user permissions, or account status.</description>
                    <dependencies>
                        <dependency>
                            <expression>last(/AbraFlexi Server Monitoring/abraflexi.network.connectivity)=0</expression>
                        </dependency>
                    </dependencies>
                    <tags>
                        <tag>
                            <tag>scope</tag>
                            <value>authentication</value>
                        </tag>
                    </tags>
                </trigger>

                <!-- Service Health Issues -->
                <trigger>
                    <uuid>748ad4d098d447d492bb935c178a7aa2</uuid>
                    <expression>last(/AbraFlexi Server Monitoring/abraflexi.network.service)=0 and last(/AbraFlexi Server Monitoring/abraflexi.network.authentication)=1</expression>
                    <name>AbraFlexi service health check failure</name>
                    <priority>HIGH</priority>
                    <description>Authentication successful but service health check failed. AbraFlexi application may be starting up, shutting down, or experiencing internal errors.</description>
                    <dependencies>
                        <dependency>
                            <expression>last(/AbraFlexi Server Monitoring/abraflexi.network.connectivity)=0</expression>
                        </dependency>
                        <dependency>
                            <expression>last(/AbraFlexi Server Monitoring/abraflexi.network.authentication)=0 and last(/AbraFlexi Server Monitoring/abraflexi.network.connectivity)=1</expression>
                        </dependency>
                    </dependencies>
                    <tags>
                        <tag>
                            <tag>scope</tag>
                            <value>service</value>
                        </tag>
                    </tags>
                </trigger>

                <!-- Application Server Status -->
                <trigger>
                    <uuid>748ad4d098d447d492bb935c178a7aa3</uuid>
                    <expression>last(/AbraFlexi Server Monitoring/abraflexi.system.appServerRunning)=0</expression>
                    <name>AbraFlexi application server is not running</name>
                    <priority>DISASTER</priority>
                    <description>AbraFlexi application server status indicates it's not running. Immediate attention required.</description>
                    <tags>
                        <tag>
                            <tag>scope</tag>
                            <value>service</value>
                        </tag>
                    </tags>
                </trigger>

                <!-- Performance Issues -->
                <trigger>
                    <uuid>748ad4d098d447d492bb935c178a7aa4</uuid>
                    <expression>last(/AbraFlexi Server Monitoring/abraflexi.system.systemLoad)&gt;5</expression>
                    <name>AbraFlexi server high system load</name>
                    <priority>WARNING</priority>
                    <description>System load is above 5.0. Server may be experiencing performance issues.</description>
                    <tags>
                        <tag>
                            <tag>scope</tag>
                            <value>performance</value>
                        </tag>
                    </tags>
                </trigger>

                <trigger>
                    <uuid>748ad4d098d447d492bb935c178a7aa5</uuid>
                    <expression>last(/AbraFlexi Server Monitoring/abraflexi.system.memoryUsed)/last(/AbraFlexi Server Monitoring/abraflexi.system.memoryHeap)&gt;0.9</expression>
                    <name>AbraFlexi high memory usage</name>
                    <priority>WARNING</priority>
                    <description>Memory usage is above 90% of heap size. Consider increasing heap size or investigating memory leaks.</description>
                    <tags>
                        <tag>
                            <tag>scope</tag>
                            <value>performance</value>
                        </tag>
                    </tags>
                </trigger>

                <trigger>
                    <uuid>748ad4d098d447d492bb935c178a7aa7</uuid>
                    <expression>last(/AbraFlexi Server Monitoring/abraflexi.system.responseTime)&gt;5000</expression>
                    <name>AbraFlexi high API response time</name>
                    <priority>WARNING</priority>
                    <description>API response time is above 5 seconds. This may indicate server performance issues or network latency.</description>
                    <tags>
                        <tag>
                            <tag>scope</tag>
                            <value>performance</value>
                        </tag>
                    </tags>
                </trigger>

                <!-- User Activity Monitoring -->
                <trigger>
                    <uuid>748ad4d098d447d492bb935c178a7aa8</uuid>
                    <expression>last(/AbraFlexi Server Monitoring/abraflexi.system.loggedUser)&gt;100</expression>
                    <name>AbraFlexi high number of logged users</name>
                    <priority>INFO</priority>
                    <description>More than 100 users are currently logged in. Monitor for potential license or performance issues.</description>
                    <tags>
                        <tag>
                            <tag>scope</tag>
                            <value>users</value>
                        </tag>
                    </tags>
                </trigger>
            </triggers>

            <valuemaps>
                <valuemap>
                    <uuid>748ad4d098d447d492bb935c178a7ab0</uuid>
                    <name>Service state</name>
                    <mappings>
                        <mapping>
                            <value>0</value>
                            <newvalue>Down</newvalue>
                        </mapping>
                        <mapping>
                            <value>1</value>
                            <newvalue>Up</newvalue>
                        </mapping>
                    </mappings>
                </valuemap>
            </valuemaps>
        </template>
    </templates>
</zabbix_export>