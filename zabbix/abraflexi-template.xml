                    <uuid>748ad4d098d447d492bb935c178a7b20</uuid>
                    <name>Unsent invoices total</name>
                    <type>ZABBIX_PASSIVE</type>
                    <key>abraflexi.invoices.unsent.total</key>
                    <delay>1h</delay>
                    <history>30d</history>
                    <trends>365d</trends>
                    <value_type>UNSIGNED</value_type>
                    <tags>
                        <tag>
                            <tag>Application</tag>
                            <value>AbraFlexi Invoices</value>
                        </tag>
                    </tags>
                    <triggers>
                        <trigger>
                            <uuid>748ad4d098d447d492bb935c178a7b21</uuid>
                            <expression>last(/AbraFlexi Server Monitoring/abraflexi.invoices.unsent.total) &gt; 10</expression>
                            <name>High number of unsent invoices</name>
                            <priority>WARNING</priority>
                        </trigger>
                        <trigger>
                            <uuid>748ad4d098d447d492bb935c178a7b22</uuid>
