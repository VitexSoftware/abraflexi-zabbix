                <item>
                    <uuid>d3f9a6c340194b2b9d3c000000000028</uuid>
                    <name>AbraFlexi version numeric</name>
                    <type>DEPENDENT</type>
                    <key>abraflexi.system.version.numeric</key>
                    <history>30d</history>
                    <preprocessing>
                        <step>
                            <type>JAVASCRIPT</type>
                            <parameters>
                                <parameter>var parts = value.split('.');
                                    var major = parseInt(parts[0], 10) || 0;
                                    var minor = parseInt(parts[1] || '0', 10);
                                    var patch = parseInt(parts[2] || '0', 10);
                                    return major * 1000000 + minor * 1000 + patch;</parameter>
                            </parameters>
                        </step>
                    </preprocessing>
                    <master_item>
                        <key>abraflexi.system.version</key>
                    </master_item>
                    <tags>
                        <tag>
                            <tag>Application</tag>
                            <value>AbraFlexi</value>
                        </tag>
