<?xml version="1.0" encoding="UTF-8"?>
<zabbix_export>
    <version>7.2</version>
    <template_groups>
        <template_group>
            <uuid>748ad4d098d447d492bb935c178a7a6c</uuid>
            <name>Templates/AbraFlexi</name>
        </template_group>
    </template_groups>

    <templates>
        <template>
            <uuid>748ad4d098d447d492bb935c178a7a6d</uuid>
            <template>AbraFlexi Server Monitoring</template>
            <name>AbraFlexi Server Monitoring</name>

            <description>Monitoring for AbraFlexi server:
- Network connectivity, authentication and service health
- System metrics via /status.json
- LLD discovery of companies
- Triggering operational issues</description>

            <groups>
                <group>
                    <name>Templates/AbraFlexi</name>
                </group>
            </groups>

            <!-- Added Template Label -->
            <tags>
                <tag>
                    <tag>label</tag>
                    <value>AbraFlexi</value>
                </tag>
            </tags>

            <!-- ============================= -->
            <!--            ITEMS              -->
            <!-- ============================= -->

            <items>
                <item>
                    <uuid>748ad4d098d447d492bb935c178a7a70</uuid>
                    <name>Network connectivity status</name>
                    <type>ZABBIX_PASSIVE</type>
                    <key>abraflexi.network.connectivity</key>
                    <history>30d</history>
                    <trends>365d</trends>
                    <value_type>UNSIGNED</value_type>
                    <valuemap>
                        <name>Service state</name>
                    </valuemap>
                </item>

                <item>
                    <uuid>748ad4d098d447d492bb935c178a7a71</uuid>
                    <name>Authentication status</name>
                    <type>ZABBIX_PASSIVE</type>
                    <key>abraflexi.network.authentication</key>
                    <history>30d</history>
                    <trends>365d</trends>
                    <value_type>UNSIGNED</value_type>
                    <valuemap>
                        <name>Service state</name>
                    </valuemap>
                </item>

                <item>
                    <uuid>748ad4d098d447d492bb935c178a7a72</uuid>
                    <name>Service health status</name>
                    <type>ZABBIX_PASSIVE</type>
                    <key>abraflexi.network.service</key>
                    <history>30d</history>
                    <trends>365d</trends>
                    <value_type>UNSIGNED</value_type>
                    <valuemap>
                        <name>Service state</name>
                    </valuemap>
                </item>

                <item>
                    <uuid>748ad4d098d447d492bb935c178a7a73</uuid>
                    <name>AbraFlexi version</name>
                    <type>ZABBIX_PASSIVE</type>
                    <key>abraflexi.system.version</key>
                    <history>30d</history>
                    <trends>0</trends>
                    <value_type>TEXT</value_type>
                </item>
                <item>
                    <uuid>748ad4d098d447d492bb935c178a7ada</uuid>
                    <name>AbraFlexi version numeric</name>
                    <type>DEPENDENT</type>
                    <key>abraflexi.system.version.numeric</key>
                    <delay>0</delay>
                    <history>30d</history>
                    <trends>365d</trends>
                    <value_type>UNSIGNED</value_type>
                    <master_item>
                        <key>abraflexi.system.version</key>
                    </master_item>
                    <preprocessing>
                        <step>
                            <type>JAVASCRIPT</type>
                            <parameters>
                                <parameter>var parts = value.split('.').map(function(part) { return parseInt(part, 10); });
if (parts.length &amp;gt;= 2) {
    var major = parts[0];
    var minor = parts[1];
    var patch = parts.length &amp;gt; 2 ? parts[2] : 0;
    return major * 1000000 + minor * 1000 + patch;
}
return 0;</parameter>
                            </parameters>
                        </step>
                    </preprocessing>
                    <triggers>
                        <trigger>
                            <uuid>748ad4d098d447d492bb935c178a7ac0</uuid>
                            <expression>last(/AbraFlexi Server Monitoring/abraflexi.system.version.numeric)&amp;gt;prev(/AbraFlexi Server Monitoring/abraflexi.system.version.numeric)</expression>
                            <name>AbraFlexi was updated</name>
                            <priority>INFO</priority>
                        </trigger>
                        <trigger>
                            <uuid>748ad4d098d447d492bb935c178a7ac1</uuid>
                            <expression>last(/AbraFlexi Server Monitoring/abraflexi.system.version.numeric)&amp;lt;prev(/AbraFlexi Server Monitoring/abraflexi.system.version.numeric)</expression>
                            <name>AbraFlexi was downgraded</name>
                            <priority>WARNING</priority>
                        </trigger>
                    </triggers>
                </item>

                <item>
                    <uuid>748ad4d098d447d492bb935c178a7a74</uuid>
                    <name>Application server running</name>
                    <type>ZABBIX_PASSIVE</type>
                    <key>abraflexi.system.appServerRunning</key>
                    <history>30d</history>
                    <trends>365d</trends>
                    <value_type>UNSIGNED</value_type>
                    <valuemap>
                        <name>Service state</name>
                    </valuemap>
                </item>

                <item>
                    <uuid>748ad4d098d447d492bb935c178a7a75</uuid>
                    <name>System load average</name>
                    <type>ZABBIX_PASSIVE</type>
                    <key>abraflexi.system.systemLoad</key>
                    <history>30d</history>
                    <trends>365d</trends>
                    <value_type>FLOAT</value_type>
                </item>

                <item>
                    <uuid>748ad4d098d447d492bb935c178a7a76</uuid>
                    <name>Memory used</name>
                    <type>ZABBIX_PASSIVE</type>
                    <key>abraflexi.system.memoryUsed</key>
                    <history>30d</history>
                    <trends>365d</trends>
                    <value_type>UNSIGNED</value_type>
                    <units>B</units>
                </item>

                <item>
                    <uuid>748ad4d098d447d492bb935c178a7a77</uuid>
                    <name>Memory heap</name>
                    <type>ZABBIX_PASSIVE</type>
                    <key>abraflexi.system.memoryHeap</key>
                    <history>30d</history>
                    <trends>365d</trends>
                    <value_type>UNSIGNED</value_type>
                    <units>B</units>
                </item>

                <item>
                    <uuid>748ad4d098d447d492bb935c178a7a78</uuid>
                    <name>Logged users total</name>
                    <type>ZABBIX_PASSIVE</type>
                    <key>abraflexi.system.loggedUser</key>
                    <value_type>UNSIGNED</value_type>
                </item>

                <item>
                    <uuid>748ad4d098d447d492bb935c178a7a81</uuid>
                    <name>Active sessions total</name>
                    <type>ZABBIX_PASSIVE</type>
                    <key>abraflexi.system.sessions</key>
                    <value_type>UNSIGNED</value_type>
                </item>

                <item>
                    <uuid>748ad4d098d447d492bb935c178a7a82</uuid>
                    <name>Bytes read</name>
                    <type>ZABBIX_PASSIVE</type>
                    <key>abraflexi.system.bytesRead</key>
                    <value_type>UNSIGNED</value_type>
                    <units>B</units>
                </item>

                <item>
                    <uuid>748ad4d098d447d492bb935c178a7a83</uuid>
                    <name>Total GC time</name>
                    <type>ZABBIX_PASSIVE</type>
                    <key>abraflexi.system.totalGcTime</key>
                    <value_type>UNSIGNED</value_type>
                    <units>ms</units>
                </item>

                <item>
                    <uuid>748ad4d098d447d492bb935c178a7a89</uuid>
                    <name>API response time</name>
                    <type>ZABBIX_PASSIVE</type>
                    <key>abraflexi.system.responseTime</key>
                    <value_type>UNSIGNED</value_type>
                    <units>ms</units>
                    <triggers>
                        <trigger>
                            <uuid>748ad4d098d447d492bb935c178a7ac2</uuid>
                            <expression>last(/AbraFlexi Server Monitoring/abraflexi.system.responseTime) &amp;gt; 5000</expression>
                            <name>Slow API response time</name>
                            <priority>WARNING</priority>
                        </trigger>
                    </triggers>
                </item>

                <item>
                    <uuid>748ad4d098d447d492bb935c178a7a84</uuid>
                    <name>Java version</name>
                    <type>ZABBIX_PASSIVE</type>
                    <key>abraflexi.system.javaVersion</key>
                    <value_type>TEXT</value_type>
                </item>

                <item>
                    <uuid>748ad4d098d447d492bb935c178a7a85</uuid>
                    <name>License name</name>
                    <type>ZABBIX_PASSIVE</type>
                    <key>abraflexi.system.licenseName</key>
                    <value_type>TEXT</value_type>
                </item>

                <item>
                    <uuid>748ad4d098d447d492bb935c178a7a86</uuid>
                    <name>License variant</name>
                    <type>ZABBIX_PASSIVE</type>
                    <key>abraflexi.system.licenseVariant</key>
                    <value_type>TEXT</value_type>
                </item>
            </items>

            <!-- ============================= -->
            <!--        DISCOVERY RULE         -->
            <!-- ============================= -->

            <discovery_rules>
                <discovery_rule>
                    <uuid>748ad4d098d447d492bb935c178a7a90</uuid>
                    <name>AbraFlexi Companies Discovery</name>
                    <type>ZABBIX_PASSIVE</type>
                    <key>abraflexi.company.lld</key>
                    <delay>1h</delay>

                    <item_prototypes>
                        <item_prototype>
                            <uuid>748ad4d098d447d492bb935c178a7a91</uuid>
                            <name>Company {#COMPANY_NAME} availability</name>
                            <type>CALCULATED</type>
                            <key>abraflexi.company.available[{#COMPANY_CODE}]</key>
                            <value_type>UNSIGNED</value_type>
                            <params>
min(last(/AbraFlexi Server Monitoring/abraflexi.network.connectivity),
    last(/AbraFlexi Server Monitoring/abraflexi.network.authentication))
                            </params>
                        </item_prototype>
                    </item_prototypes>

                    <trigger_prototypes>
                        <trigger_prototype>
                            <uuid>748ad4d098d447d492bb935c178a7a95</uuid>
                            <expression>last(/AbraFlexi Server Monitoring/abraflexi.company.available[{#COMPANY_CODE}])=0</expression>
                            <name>AbraFlexi company {#COMPANY_NAME} is unavailable</name>
                            <priority>HIGH</priority>
                        </trigger_prototype>
                    </trigger_prototypes>
                </discovery_rule>
            </discovery_rules>

            <!-- ============================= -->
            <!--          VALUEMAPS           -->
            <!-- ============================= -->

            <valuemaps>
                <valuemap>
                    <uuid>748ad4d098d447d492bb935c178a7ab0</uuid>
                    <name>Service state</name>
                    <mappings>
                        <mapping>
                            <value>0</value>
                            <newvalue>Down</newvalue>
                        </mapping>
                        <mapping>
                            <value>1</value>
                            <newvalue>Up</newvalue>
                        </mapping>
                    </mappings>
                </valuemap>
            </valuemaps>
        </template>
    </templates>
</zabbix_export>
