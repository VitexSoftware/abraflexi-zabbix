    <templates>
        <template>
            <uuid>748ad4d098d447d492bb935c178a7a6d</uuid>
            <template>Remote AbraFlexi Server Monitoring</template>
            <name>Remote AbraFlexi Server Monitoring</name>
            <description>Monitoring for AbraFlexi server:
                - Network connectivity, authentication and service health
                - System metrics via /status.json
                - LLD discovery of companies
                - Triggering operational issues
                - LLD discovery of API host and automatic host creation</description>
            <groups>
                <group>
                    <name>Templates/AbraFlexi</name>
                </group>
            </groups>
            <items>
                <item>
                    <uuid>d3f9a6c300014b2b9d3c000000000001</uuid>
                    <name>API server hostname</name>
                    <type>DEPENDENT</type>
                    <key>abraflexi.config.hostname</key>
                    <master_item>
                        <key>abraflexi.config.url</key>
                    </master_item>
                    <value_type>TEXT</value_type>
                    <preprocessing>
                        <step>
                            <type>REGEX</type>
                            <parameters>
                                <parameter>https?://([^/:]+).*</parameter>
                                <parameter>\1</parameter>
                            </parameters>
                        </step>
                    </preprocessing>
                    <tags>
                        <tag>
                            <tag>Application</tag>
                            <value>AbraFlexi</value>
                        </tag>
                    </tags>
                </item>
                <item>
                    <uuid>60b4a0204045415ea4d2d01fb6b60978</uuid>
                    <name>Configuration URL</name>
                    <key>abraflexi.config.url</key>
                    <value_type>TEXT</value_type>
                    <tags>
                        <tag>
                            <tag>Application</tag>
                            <value>AbraFlexi</value>
                        </tag>
                    </tags>
                </item>
            </items>
            <discovery_rules>
                <discovery_rule>
                    <uuid>748ad4d098d447d492bb935c178a7a90</uuid>
                    <name>AbraFlexi Companies Discovery</name>
                    <key>abraflexi.company.lld</key>
                    <delay>1h</delay>
                    <item_prototypes>
                        <item_prototype>
                            <uuid>748ad4d098d447d492bb935c178a7a91</uuid>
                            <name>Company {#COMPANY_NAME} availability</name>
                            <type>CALCULATED</type>
                            <key>abraflexi.company.available[{#COMPANY_CODE}]</key>
                            <params>
                                min(last(//abraflexi.network.connectivity),
                                last(//abraflexi.network.authentication))
                            </params>
                        </item_prototype>
                    </item_prototypes>
                    <graph_prototypes>
                        <graph_prototype>
                            <uuid>748ad4d098d447d492bb935c178a7a96</uuid>
                            <name>Company {#COMPANY_NAME} Availability</name>
                            <graph_items>
                                <graph_item>
                                    <color>1A7C11</color>
                                    <item>
                                        <host>Remote AbraFlexi Server Monitoring</host>
                                        <key>abraflexi.company.available[{#COMPANY_CODE}]</key>
                                    </item>
                                </graph_item>
                            </graph_items>
                        </graph_prototype>
                    </graph_prototypes>
                </discovery_rule>
                <discovery_rule>
                    <uuid>d3f9a6c320024b2b9d3c000000000002</uuid>
                    <name>AbraFlexi API Host Discovery</name>
                    <key>abraflexi.api_host.lld</key>
                    <type>DEPENDENT</type>
                    <delay>1m</delay>
                    <master_item>
                        <key>abraflexi.config.hostname</key>
                    </master_item>
                    <preprocessing>
                        <step>
                            <type>JAVASCRIPT</type>
                            <parameters>
                                <parameter>
                                    return JSON.stringify({
                                    "data": [
                                    {"{#APIHOST}": value}
                                    ]
                                    });
                                </parameter>
                            </parameters>
                        </step>
                    </preprocessing>
                    <host_prototypes>
                        <host_prototype>
                            <uuid>d3f9a6c330034b2b9d3c000000000003</uuid>
                            <host>{#APIHOST}</host>
                            <name>{#APIHOST}</name>
                            <status>ENABLED</status>
                            <group_links>
                                <group_link>
                                    <group>
                                        <name>AbraFlexi Servers</name>
                                    </group>
                                </group_link>
                            </group_links>
                            <templates>
                                <template>
                                    <name>AbraFlexi Discovered Node</name>
                                </template>
                            </templates>
                            <tags>
                                <tag>
                                    <tag>Application</tag>
                                    <value>AbraFlexi</value>
                                </tag>
                            </tags>
                        </host_prototype>
                    </host_prototypes>
                </discovery_rule>
            </discovery_rules>
            <tags>
                <tag>
                    <tag>label</tag>
                    <value>AbraFlexi</value>
                </tag>
            </tags>
            <valuemaps>
                <valuemap>
                    <uuid>748ad4d098d447d492bb935c178a7ab0</uuid>
                    <name>Service state</name>
                    <mappings>
                        <mapping>
                            <value>0</value>
                            <newvalue>Down</newvalue>
                        </mapping>
                        <mapping>
                            <value>1</value>
                            <newvalue>Up</newvalue>
                        </mapping>
                    </mappings>
                </valuemap>
            </valuemaps>
        </template>
